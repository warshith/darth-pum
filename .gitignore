# Upstream simulators are cloned, not vendored. See README / setup.sh
third_party/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Data + model checkpoints (re-downloadable)
data/
checkpoints/
*.th
*.pt
*.pth

# Generated outputs — regenerate with experiments/run_all.py
results/*.json
figures/*.pdf
figures/*.png

# paper/: track report.tex, IEEEtran.cls, and figs/*.pdf as source.
# Everything else here is build output or submission packaging, not source.
paper/*.pdf
paper/*.zip
paper/template_src/
paper/darth-pum-latex-source/

# LaTeX build artifacts
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls
*.toc
*.nav
*.snm
*.vrb

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp
